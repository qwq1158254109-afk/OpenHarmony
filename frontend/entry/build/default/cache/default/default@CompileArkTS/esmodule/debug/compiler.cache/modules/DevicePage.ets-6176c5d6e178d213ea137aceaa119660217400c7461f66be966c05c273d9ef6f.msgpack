import { PageTitleBar } from '../components/PageTitleBar';
import { SectionHeader } from '../components/SectionHeader';
import { StatusBadge } from '../components/StatusBadge';
import { CampusDevice, DeviceType } from '../models/Device';
import { UserProfile } from '../models/User';
import { DeviceTrustManager } from '../services/DeviceTrustManager';
import { DeviceService } from '../services/DeviceService';
import { MockData } from '../services/MockData';
import { AppColors, AppLayout } from '../utils/Constants';
import { FormatUtil } from '../utils/FormatUtil';

@Entry
@Component
struct DevicePage {
  @State user: UserProfile = MockData.users[0];
  @State devices: CampusDevice[] = [];
  @State newType: DeviceType = 'tablet';
  private types: DeviceType[] = ['phone', 'tablet', 'wearable'];

  aboutToAppear(): void {
    this.user = AppStorage.Get<UserProfile>('currentUser') || MockData.users[0];
    this.refresh();
  }

  private refresh(): void {
    this.devices = DeviceService.listDevices(this.user.id);
  }

  private addDevice(): void {
    DeviceService.bindDevice({
      userId: this.user.id,
      deviceName: DeviceService.nextDeviceName(this.newType),
      deviceType: this.newType,
      trusted: false
    });
    this.refresh();
  }

  private typeMarker(type: DeviceType): string {
    if (type === 'phone') {
      return 'PH';
    }
    if (type === 'tablet') {
      return 'TB';
    }
    return 'WT';
  }

  build() {
    Scroll() {
      Column({ space: 16 }) {
        PageTitleBar({ title: 'è®¾å¤‡ç®¡ç†', subtitle: 'ç»‘å®šæ‰‹æœºã€å¹³æ¿å’Œç©¿æˆ´è®¾å¤‡ï¼Œé…ç½®å¯ä¿¡è®¤è¯èƒ½åŠ›' })

        Column({ space: 12 }) {
          SectionHeader({ title: 'æ·»åŠ ååŒè®¾å¤‡', subtitle: 'æ¨¡æ‹Ÿ OpenHarmony åˆ†å¸ƒå¼è®¾å¤‡åŠ å…¥è®¤è¯ç½‘ç»œ' })
          Grid() {
            ForEach(this.types, (item: DeviceType) => {
              GridItem() {
                FeatureCard({
                  title: FormatUtil.deviceTypeLabel(item),
                  subtitle: DeviceService.nextDeviceName(item),
                  marker: this.typeMarker(item),
                  active: this.newType === item
                })
                  .onClick(() => {
                    this.newType = item;
                  })
              }
            }, (item: DeviceType) => item)
          }
          .columnsTemplate('1fr 1fr')
          .columnsGap(10)
          .rowsGap(10)
          .height(182)
          Button('æ·»åŠ è®¾å¤‡')
            .width('100%')
            .height(44)
            .backgroundColor(AppColors.primary)
            .borderRadius(8)
            .onClick(() => this.addDevice())
        }
        .padding(16)
        .backgroundColor(AppColors.surface)
        .borderRadius(8)
        .border({ width: 1, color: AppColors.border })

        SectionHeader({ title: 'å·²ç»‘å®šè®¾å¤‡', subtitle: 'å¯ä¿¡è®¾å¤‡å¯å‚ä¸æ— æ„Ÿè®¤è¯å’Œè·¨ç«¯åŒæ­¥' })
        Grid() {
          ForEach(this.devices, (item: CampusDevice) => {
            GridItem() {
              Column({ space: 10 }) {
                Row() {
                  Text(this.typeMarker(item.type))
                    .fontSize(14)
                    .fontWeight(FontWeight.Bold)
                    .fontColor(item.trusted ? '#FFFFFF' : AppColors.primary)
                    .textAlign(TextAlign.Center)
                    .width(42)
                    .height(42)
                    .backgroundColor(item.trusted ? AppColors.primary : AppColors.cyanSoft)
                    .borderRadius(8)
                  Column() {
                    Text(item.name)
                      .fontSize(17)
                      .fontWeight(FontWeight.Bold)
                      .fontColor(AppColors.text)
                    Text(`${FormatUtil.deviceTypeLabel(item.type)} Â· ${item.lastSeen}`)
                      .fontSize(12)
                      .fontColor(AppColors.muted)
                      .margin({ top: 4 })
                    Text(`${item.deviceOs} Â· ${FormatUtil.distributedRoleLabel(item.distributedRole)}`)
                      .fontSize(12)
                      .fontColor(AppColors.muted)
                      .margin({ top: 4 })
                  }
                  .alignItems(HorizontalAlign.Start)
                  .layoutWeight(1)
                  .margin({ left: 12 })
                  StatusBadge({ text: item.online ? 'åœ¨çº¿' : 'ç¦»çº¿', status: item.online ? 'success' : 'unauthenticated' })
                }
                Row() {
                  StatusBadge({ text: `${DeviceTrustManager.label(item.trust.level)} ${item.trust.score}`, status: DeviceTrustManager.badgeStatus(item.trust.level) })
                  Blank()
                    .layoutWeight(1)
                }
                Text(item.trust.factors.join('ã€'))
                  .fontSize(12)
                  .fontColor(AppColors.muted)
                  .lineHeight(18)
                Row({ space: 10 }) {
                  Button(item.trusted ? 'å–æ¶ˆå¯ä¿¡' : 'è®¾ä¸ºå¯ä¿¡')
                    .layoutWeight(1)
                    .height(38)
                    .fontSize(13)
                    .fontColor(AppColors.primary)
                    .backgroundColor(AppColors.cyanSoft)
                    .borderRadius(8)
                    .onClick(() => {
                      DeviceService.toggleTrusted(item.id);
                      this.refresh();
                    })
                  Button('åˆ é™¤')
                    .layoutWeight(1)
                    .height(38)
                    .fontSize(13)
                    .fontColor(AppColors.danger)
                    .backgroundColor(AppColors.dangerSoft)
                    .borderRadius(8)
                    .onClick(() => {
                      DeviceService.removeDevice(item.id);
                      this.refresh();
