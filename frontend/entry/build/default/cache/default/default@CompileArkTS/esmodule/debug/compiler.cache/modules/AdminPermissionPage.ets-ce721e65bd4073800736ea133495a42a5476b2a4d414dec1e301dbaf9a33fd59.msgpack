import { PortalMockService } from '../services/PortalMockService';
import { AppColors, AppLayout, AppRoutes } from '../utils/Constants';
import { PermissionUtil } from '../utils/PermissionUtil';

@Entry
@Component
struct AdminPermissionPage {
  @State state: PageLoadState = 'loading';
  @State permissions: AdminPermissionItem[] = [];

  aboutToAppear(): void {
    if (!PermissionUtil.ensurePageAccess(AppRoutes.adminPermission)) {
      return;
    }
    this.permissions = PortalMockService.adminPermissions();
    this.state = this.permissions.length === 0 ? 'empty' : 'ready';
  }

  private revoke(item: AdminPermissionItem): void {
    AlertDialog.show({
      title: 'ç¡®è®¤æ’¤é”€æƒé™',
      message: `ç¡®å®šæ’¤é”€ ${item.owner} çš„ ${item.role} æƒé™å—ï¼Ÿ`,
      primaryButton: { value: 'å–æ¶ˆ', action: () => {} },
      secondaryButton: {
        value: 'ç¡®è®¤æ’¤é”€',
        fontColor: AppColors.danger,
        action: () => {
          this.permissions = this.permissions.filter((permission: AdminPermissionItem) => permission.id !== item.id);
          this.state = this.permissions.length === 0 ? 'empty' : 'ready';
          promptAction.showToast({ message: 'æƒé™å·²æ’¤é”€' });
        }
      }
    });
  }

  build() {
    Scroll() {
      Column({ space: 16 }) {
        PageTitleBar({ title: 'ç®¡ç†å‘˜æƒé™ç®¡ç†', subtitle: 'ç®¡ç†ä¸åŒè§’è‰²çš„æ•°æ®è®¿é—®å’Œé…ç½®æƒé™' })
        if (this.state !== 'ready') {
          StatePanel({ state: this.state, emptyText: 'æš‚æ— æƒé™é¡¹', errorText: 'æƒé™æ•°æ®åŠ è½½å¤±è´¥' })
        } else {
          ForEach(this.permissions, (item: AdminPermissionItem) => {
            Row() {
              Column() {
                Text(`${item.role} Â· ${item.owner}`)
                  .fontSize(17)
                  .fontWeight(FontWeight.Bold)
                  .fontColor(AppColors.text)
                Text(`${item.scope} Â· ${item.enabled ? 'å·²å¯ç”¨' : 'å·²åœç”¨'}`)
                  .fontSize(12)
                  .fontColor(AppColors.muted)
                  .margin({ top: 4 })
              }
              .alignItems(HorizontalAlign.Start)
              .layoutWeight(1)
              Button('æ’¤é”€')
                .height(36)
