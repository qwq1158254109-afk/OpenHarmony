        ForEach(this.records(), (item: AuthRecord) => {
          Column({ space: 10 }) {
            Row() {
              Text(FormatUtil.sceneLabel(item.scene).substring(0, 1))
                .fontSize(16)
                .fontWeight(FontWeight.Bold)
                .fontColor('#FFFFFF')
                .textAlign(TextAlign.Center)
                .width(40)
                .height(40)
                .backgroundColor(item.result === 'success' ? AppColors.primary : AppColors.danger)
                .borderRadius(8)
              Column() {
                Text(`${FormatUtil.sceneLabel(item.scene)} Â· ${item.userName}`)
                  .fontSize(17)
                  .fontWeight(FontWeight.Bold)
                  .fontColor(AppColors.text)
                Text(`${item.time} Â· ${item.location}`)
                  .fontSize(12)
                  .fontColor(AppColors.muted)
                  .margin({ top: 4 })
              }
              .alignItems(HorizontalAlign.Start)
              .layoutWeight(1)
              .margin({ left: 12 })
              StatusBadge({ text: item.result === 'success' ? 'æˆåŠŸ' : 'å¤±è´¥', status: item.status })
            }
            Text(`${item.deviceName} Â· ${FormatUtil.methodLabel(item.method)}`)
              .fontSize(13)
              .fontColor(AppColors.muted)
            Row({ space: 10 }) {
              Text(`å­¦å·ï¼š${this.accountFor(item)}`)
                .fontSize(12)
                .fontColor(AppColors.text)
                .layoutWeight(1)
              Text(`è®¾å¤‡ IDï¼š${this.deviceIdFor(item)}`)
                .fontSize(12)
                .fontColor(AppColors.text)
                .layoutWeight(1)
            }
            .width('100%')
            Row() {
              Text(`é£é™©è¯„åˆ† ${item.risk.riskScore}`)
                .fontSize(13)
                .fontWeight(FontWeight.Medium)
                .fontColor(AppColors.text)
                .layoutWeight(1)
              StatusBadge({ text: FormatUtil.riskLabel(item.risk.riskLevel), status: item.risk.riskLevel })
            }
            Text(item.risk.riskReason)
              .fontSize(12)
              .fontColor(AppColors.muted)
              .lineHeight(18)
            Text(item.risk.suggestion)
              .fontSize(12)
              .fontColor(AppColors.primary)
              .lineHeight(18)
          }
          .width('100%')
          .padding(14)
          .backgroundColor(AppColors.surface)
          .borderRadius(8)
          .border({ width: 1, color: AppColors.border })
        }, (item: AuthRecord) => item.id)
      }
      .width('100%')
      .constraintSize({ maxWidth: AppLayout.pageMaxWidth })
      .alignSelf(ItemAlign.Center)
      .padding({ left: AppLayout.pagePadding, right: AppLayout.pagePadding, bottom: 30 })
    }
    .backgroundColor(AppColors.background)
  }
}
