          }
          GridItem() {
            StatCard({ title: 'é«˜é£é™©', value: `${this.allRecords().filter(item => item.risk.riskLevel === 'high').length}`, hint: 'éœ€ç®¡ç†å‘˜é‡ç‚¹å…³æ³¨', color: AppColors.danger })
