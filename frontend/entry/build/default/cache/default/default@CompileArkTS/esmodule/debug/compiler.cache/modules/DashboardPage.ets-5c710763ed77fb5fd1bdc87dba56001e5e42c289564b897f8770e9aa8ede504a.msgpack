import { AppColors, AppLayout, AppRoutes } from '../utils/Constants';
import { FormatUtil } from '../utils/FormatUtil';
import { PermissionUtil } from '../utils/PermissionUtil';

@Entry
@Component
struct DashboardPage {
  @State user: UserProfile = MockData.users[0];
  @State todayCount: number = 0;
  @State latestStatus: string = 'æœªè®¤è¯';
  @State latestRisk: string = 'ä½é£é™©';
  @State onlineDeviceCount: number = 0;
  @State trustedDeviceCount: number = 0;
  @State menuActions: PortalAction[] = [];
  @State hoverMenuKey: string = '';

  aboutToAppear(): void {
    AuthSessionService.initialize();
    const currentUser = AuthSessionService.currentUser();
    if (!AuthSessionService.isLoggedIn() || !currentUser) {
      router.replaceUrl({ url: AppRoutes.login });
      return;
    }
    this.user = currentUser;
    const records = AuthService.recentRecords(this.user.id);
    const devices = DeviceService.listDevices(this.user.id);
    if (this.user.role === 'student') {
      this.menuActions = PortalMockService.studentActions();
    } else if (this.user.role === 'teacher') {
      this.menuActions = PortalMockService.teacherActions();
    } else {
      this.menuActions = PortalMockService.adminActions();
    }
    this.todayCount = records.length;
    this.onlineDeviceCount = devices.filter((item: CampusDevice) => item.online).length;
    this.trustedDeviceCount = devices.filter((item: CampusDevice) => item.trusted).length;
    if (records.length > 0) {
      this.latestStatus = records[0].result === 'success' ? 'è®¤è¯æˆåŠŸ' : 'è®¤è¯å¤±è´¥';
      this.latestRisk = FormatUtil.riskLabel(records[0].risk.riskLevel);
    }
  }

  private go(url: string): void {
    if (!PermissionUtil.canViewFeature(this.user.role, url)) {
      promptAction.showToast({ message: 'å½“å‰è§’è‰²æ— æƒè®¿é—®è¯¥åŠŸèƒ½' });
      return;
    }
    router.pushUrl({ url });
  }

  private handleMenuHover(key: string, isHover: boolean): void {
    if (isHover) {
      this.hoverMenuKey = key;
      return;
    }
    if (this.hoverMenuKey === key) {
      this.hoverMenuKey = '';
    }
  }

  private logout(): void {
    AlertDialog.show({
      title: 'ç¡®è®¤é€€å‡º',
      message: 'ç¡®å®šè¦é€€å‡ºå½“å‰è´¦å·å—ï¼Ÿ',
      primaryButton: {
        value: 'å–æ¶ˆ',
        action: () => {
        }
      },
      secondaryButton: {
        value: 'ç¡®è®¤é€€å‡º',
        fontColor: AppColors.danger,
        action: () => {
          AuthSessionService.clearLogin();
          promptAction.showToast({ message: 'å·²é€€å‡ºç™»å½•' });
          router.replaceUrl({ url: AppRoutes.login });
        }
      }
    });
  }

  private recentRecords(): AuthRecord[] {
    return AuthService.recentRecords(this.user.id).slice(0, 3);
  }

  build() {
    Scroll() {
      Column({ space: 18 }) {
        PageTitleBar({
          title: 'æ™ºæ…§æ ¡å›­è®¤è¯ä¸­å¿ƒ',
          subtitle: `${this.user.name} Â· ${FormatUtil.roleLabel(this.user.role)} Â· ${this.user.department}`,
          showBack: false
        })

        Row() {
          Blank()
          Button('é€€å‡ºç™»å½•')
            .height(36)
            .fontSize(13)
            .fontColor(AppColors.danger)
            .backgroundColor(AppColors.dangerSoft)
            .borderRadius(8)
            .onClick(() => {
              this.logout();
            })
        }
        .width('100%')

        Row() {
          Column() {
            Text('OpenHarmony åˆ†å¸ƒå¼æ— æ„Ÿèº«ä»½è®¤è¯')
              .fontSize(23)
              .fontWeight(FontWeight.Bold)
              .fontColor('#FFFFFF')
            Text('æ‰‹æœºã€å¹³æ¿å’Œç©¿æˆ´è®¾å¤‡ååŒå®Œæˆèº«ä»½æ ¸éªŒï¼Œé€‚é…è€ƒå‹¤ã€é—¨ç¦ã€å›¾ä¹¦é¦†å’Œè¯¾å ‚ç­¾åˆ°åœºæ™¯ã€‚')
              .fontSize(13)
              .fontColor('#D7EEF7')
              .lineHeight(20)
              .margin({ top: 8 })
          }
          .alignItems(HorizontalAlign.Start)
          .layoutWeight(1)
          Text(this.user.avatarText)
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor(AppColors.hero)
            .textAlign(TextAlign.Center)
            .width(52)
            .height(52)
            .backgroundColor('#DFF6FF')
            .borderRadius(8)
        }
        .width('100%')
        .alignItems(VerticalAlign.Center)
        .padding(18)
        .backgroundColor(AppColors.hero)
        .borderRadius(8)

        Grid() {
          GridItem() {
            StatCard({ title: 'å½“å‰å­¦å·', value: this.user.account, hint: FormatUtil.roleLabel(this.user.role), color: AppColors.primary })
          }
          GridItem() {
            StatCard({ title: 'èº«ä»½çŠ¶æ€', value: 'å·²ç™»å½•', hint: `${this.user.college}`, color: AppColors.success })
          }
          GridItem() {
            StatCard({ title: 'è®¾å¤‡çŠ¶æ€', value: `${this.onlineDeviceCount}/${this.trustedDeviceCount}`, hint: 'åœ¨çº¿è®¾å¤‡ / å¯ä¿¡è®¾å¤‡', color: AppColors.accent })
          }
          GridItem() {
            StatCard({ title: 'æœ€è¿‘è®¤è¯', value: this.latestStatus, hint: `æ¬¡æ•° ${this.todayCount} Â· ${this.latestRisk}`, color: this.latestStatus === 'è®¤è¯æˆåŠŸ' ? AppColors.success : AppColors.warning })
          }
        }
        .columnsTemplate('1fr 1fr')
        .columnsGap(12)
        .rowsGap(12)
        .height(264)

        Column({ space: 12 }) {
          SectionHeader({ title: 'å¿«æ·å…¥å£', subtitle: `${FormatUtil.roleLabel(this.user.role)}å¯è®¿é—®åŠŸèƒ½` })
          Grid() {
            ForEach(this.menuActions, (item: PortalAction) => {
              GridItem() {
                this.MenuButton(item.title, item.subtitle, item.marker, item.route, item.status === 'success')
              }
            }, (item: PortalAction): string => item.id)
          }
          .columnsTemplate('1fr 1fr')
          .columnsGap(12)
          .rowsGap(12)
        }
        .width('100%')

        Column({ space: 12 }) {
          SectionHeader({ title: 'æœ€è¿‘è®¤è¯', subtitle: 'æ‰‹æœºå‘èµ·ï¼Œå¹³æ¿åŒæ­¥å±•ç¤ºè®¤è¯ç»“æœ' })
          ForEach(this.recentRecords(), (item: AuthRecord) => {
            Row() {
              Column() {
                Text(FormatUtil.sceneLabel(item.scene))
                  .fontSize(16)
                  .fontWeight(FontWeight.Medium)
                  .fontColor(AppColors.text)
                Text(`${item.time} Â· ${item.location}`)
                  .fontSize(12)
                  .fontColor(AppColors.muted)
                  .margin({ top: 4 })
                Text(`${item.deviceName} Â· ${FormatUtil.methodLabel(item.method)}`)
                  .fontSize(12)
                  .fontColor(AppColors.muted)
                  .margin({ top: 4 })
              }
              .alignItems(HorizontalAlign.Start)
              .layoutWeight(1)
              StatusBadge({ text: item.result === 'success' ? 'é€šè¿‡' : 'å¤±è´¥', status: item.status })
