import { StatePanel } from '../components/StatePanel';
import { StatusBadge } from '../components/StatusBadge';
import { PageLoadState, RealtimeAuthEvent } from '../models/CampusPortal';
import { PortalMockService } from '../services/PortalMockService';
import { AppColors, AppLayout } from '../utils/Constants';
import { FormatUtil } from '../utils/FormatUtil';

@Entry
@Component
struct TerminalRealtimeScreenPage {
  @State state: PageLoadState = 'loading';
  @State events: RealtimeAuthEvent[] = [];

  aboutToAppear(): void {
    this.events = PortalMockService.realtimeEvents();
    this.state = this.events.length === 0 ? 'empty' : 'ready';
  }

  build() {
    Scroll() {
      Column({ space: 16 }) {
        PageTitleBar({ title: 'ç»ˆç«¯å®æ—¶è®¤è¯å¤§å±', subtitle: 'å®æ—¶å±•ç¤ºç»ˆç«¯è®¤è¯ç»“æœã€å»¶è¿Ÿå’Œé£é™©ç­‰çº§' })
        if (this.state !== 'ready') {
          StatePanel({ state: this.state, emptyText: 'æš‚æ— å®æ—¶è®¤è¯äº‹ä»¶', errorText: 'å®æ—¶å¤§å±åŠ è½½å¤±è´¥' })
        } else {
          Row({ space: 12 }) {
            Text('å®æ—¶è®¤è¯æµ')
              .fontSize(24)
              .fontWeight(FontWeight.Bold)
              .fontColor('#FFFFFF')
              .layoutWeight(1)
            Text(`${this.events.length} æ¡`)
              .fontSize(18)
              .fontWeight(FontWeight.Bold)
              .fontColor('#DFF6FF')
          }
          .width('100%')
          .padding(18)
          .backgroundColor(AppColors.hero)
          .borderRadius(8)
          ForEach(this.events, (item: RealtimeAuthEvent) => {
            Row() {
              Text(item.time)
                .fontSize(16)
                .fontWeight(FontWeight.Bold)
                .fontColor(AppColors.primary)
                .width(82)
              Column() {
                Text(`${item.terminal} Â· ${item.studentId}`)
                  .fontSize(16)
                  .fontWeight(FontWeight.Bold)
                  .fontColor(AppColors.text)
                Text(`ç»“æœ ${item.result} Â· å»¶è¿Ÿ ${item.latency}`)
                  .fontSize(12)
                  .fontColor(AppColors.muted)
                  .margin({ top: 4 })
              }
              .alignItems(HorizontalAlign.Start)
              .layoutWeight(1)
              StatusBadge({ text: FormatUtil.riskLabel(item.riskLevel), status: item.riskLevel })
            }
            .width('100%')
            .padding(14)
            .backgroundColor(AppColors.surface)
            .borderRadius(8)
            .border({ width: 1, color: item.riskLevel === 'high' ? AppColors.danger : AppColors.border })
          }, (item: RealtimeAuthEvent): string => item.id)
        }
      }
      .width('100%')
      .constraintSize({ maxWidth: AppLayout.pageMaxWidth })
      .alignSelf(ItemAlign.Center)
      .padding({ left: AppLayout.pagePadding, right: AppLayout.pagePadding, bottom: 30 })
    }
    .backgroundColor(AppColors.background)
  }
}
