    this.resultTitle = 'æ­£åœ¨æ‰§è¡Œæ¼”ç¤º';
    this.resultSummary = item.title;
    this.resultDetail = 'æ­£åœ¨æ¨¡æ‹Ÿè®¾å¤‡å‘ç°ã€é£é™©è¯„ä¼°ã€æƒé™åˆ¤æ–­å’Œç»“æœåŒæ­¥...';
    this.resultStatus = item.status;
    this.resultTime = 'æ‰§è¡Œä¸­';

    setTimeout(() => {
      const result: DefenseDemoResult = PortalMockService.defenseDemoResult(item.id);
      this.resultTitle = result.title;
      this.resultSummary = result.summary;
      this.resultDetail = result.detail;
      this.resultStatus = result.status;
      this.resultTime = result.timestamp;
      const logItem: DefenseDemoLog = {
        id: `${item.id}-${Date.now()}`,
        scenarioTitle: item.title,
        message: result.detail,
        result: result.summary,
        timestamp: result.timestamp,
        status: result.status
      };
      this.logs = [logItem].concat(this.logs);
      this.runningId = '';
      promptAction.showToast({ message: result.title });
    }, 650);
  }

  private colorOf(status: PortalStatus): string {
    if (status === 'success') {
      return AppColors.success;
    }
    if (status === 'warning') {
      return AppColors.warning;
    }
    if (status === 'danger') {
      return AppColors.danger;
    }
    return AppColors.primary;
  }

  private buttonText(item: DefenseDemoScenario): string {
    if (this.runningId === item.id) {
      return 'æ‰§è¡Œä¸­...';
    }
    return item.buttonText;
  }

  @Builder
  ScenarioCard(item: DefenseDemoScenario) {
    Column({ space: 12 }) {
      Row() {
        Text(item.marker)
          .fontSize(15)
          .fontWeight(FontWeight.Bold)
          .fontColor('#FFFFFF')
          .textAlign(TextAlign.Center)
          .width(42)
          .height(42)
          .backgroundColor(this.colorOf(item.status))
          .borderRadius(8)
        Column() {
          Text(item.title)
            .fontSize(17)
            .fontWeight(FontWeight.Bold)
            .fontColor(AppColors.text)
          Text(item.subtitle)
            .fontSize(12)
            .fontColor(AppColors.muted)
            .lineHeight(18)
            .margin({ top: 4 })
        }
        .alignItems(HorizontalAlign.Start)
        .layoutWeight(1)
        .margin({ left: 12 })
      }
      Button(this.buttonText(item))
        .width('100%')
        .height(42)
        .fontSize(14)
        .fontWeight(FontWeight.Medium)
        .fontColor('#FFFFFF')
        .backgroundColor(this.runningId.length > 0 && this.runningId !== item.id ? AppColors.borderStrong : this.colorOf(item.status))
        .borderRadius(8)
        .onClick(() => this.runScenario(item))
    }
    .width('100%')
    .padding(14)
    .backgroundColor(AppColors.surface)
    .borderRadius(8)
    .border({ width: 1, color: this.colorOf(item.status) })
    .shadow({ radius: 10, color: '#120F5068', offsetX: 0, offsetY: 4 })
  }

  build() {
    Scroll() {
      Column({ space: 18 }) {
        PageTitleBar({ title: 'ç­”è¾©æ¼”ç¤ºæ¨¡å¼', subtitle: 'ä¸€é”®æ¨¡æ‹Ÿæ— æ„Ÿèº«ä»½è®¤è¯æ ¸å¿ƒåœºæ™¯ï¼Œé€‚åˆç°åœºæ¼”ç¤º' })

        Column({ space: 10 }) {
          Row() {
            Text(this.resultTitle)
              .fontSize(22)
              .fontWeight(FontWeight.Bold)
              .fontColor('#FFFFFF')
              .layoutWeight(1)
            Text(this.resultTime)
              .fontSize(13)
              .fontColor('#D7EEF7')
          }
          Text(this.resultSummary)
            .fontSize(15)
            .fontColor('#EAF7F0')
            .lineHeight(22)
          Text(this.resultDetail)
            .fontSize(13)
            .fontColor('#D7EEF7')
            .lineHeight(20)
        }
        .width('100%')
        .padding(18)
        .backgroundColor(this.colorOf(this.resultStatus))
        .borderRadius(8)

        if (this.state !== 'ready') {
          StatePanel({ state: this.state, emptyText: 'æš‚æ— æ¼”ç¤ºåŠ¨ä½œ', errorText: 'æ¼”ç¤ºæ¨¡å¼åŠ è½½å¤±è´¥' })
        } else {
          SectionHeader({ title: 'ä¸€é”®æ¼”ç¤ºåŠ¨ä½œ', subtitle: 'å»ºè®®ä»ä¸Šåˆ°ä¸‹æŒ‰åœºæ™¯é¡ºåºæ¼”ç¤º' })
          Grid() {
            ForEach(this.scenarios, (item: DefenseDemoScenario) => {
              GridItem() {
                this.ScenarioCard(item)
              }
            }, (item: DefenseDemoScenario): string => item.id)
          }
          .columnsTemplate('1fr 1fr')
          .columnsGap(12)
          .rowsGap(12)
        }

        Column({ space: 12 }) {
          SectionHeader({ title: 'æ¼”ç¤ºæ—¥å¿—', subtitle: 'æ¯æ¬¡ç‚¹å‡»éƒ½ä¼šå†™å…¥ä¸€æ¡ Mock æ—¥å¿—ï¼Œä¾¿äºç­”è¾©è¿½è¸ª' })
          if (this.logs.length === 0) {
            StatePanel({ state: 'empty', emptyText: 'å°šæœªæ‰§è¡Œæ¼”ç¤ºåŠ¨ä½œ' })
          } else {
            ForEach(this.logs, (item: DefenseDemoLog) => {
              Column({ space: 8 }) {
                Row() {
                  Text(item.scenarioTitle)
                    .fontSize(16)
                    .fontWeight(FontWeight.Bold)
                    .fontColor(AppColors.text)
                    .layoutWeight(1)
                  Text(item.timestamp)
                    .fontSize(12)
                    .fontColor(AppColors.muted)
                }
                Text(item.result)
                  .fontSize(13)
                  .fontColor(this.colorOf(item.status))
                  .lineHeight(19)
                Text(item.message)
                  .fontSize(12)
                  .fontColor(AppColors.muted)
                  .lineHeight(18)
              }
              .width('100%')
              .padding(14)
              .backgroundColor(AppColors.surface)
              .borderRadius(8)
              .border({ width: 1, color: this.colorOf(item.status) })
            }, (item: DefenseDemoLog): string => item.id)
          }
        }
        .width('100%')
      }
      .width('100%')
      .constraintSize({ maxWidth: AppLayout.pageMaxWidth })
      .alignSelf(ItemAlign.Center)
      .padding({ left: AppLayout.pagePadding, right: AppLayout.pagePadding, bottom: 30 })
    }
    .backgroundColor(AppColors.background)
  }
}
