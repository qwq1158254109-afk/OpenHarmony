  static passageRecords(user?: UserProfile): PassageRecordItem[] {
    const records: PassageRecordItem[] = [
      { id: 'pr-001', studentId: 'student001', deviceId: 'phone-001', place: 'ç»¼åˆæ•™å­¦æ¥¼ A203', result: 'æˆåŠŸ', time: '2026-05-09 08:10', riskLevel: 'low' },
      { id: 'pr-002', studentId: 'student001', deviceId: 'watch-008', place: 'å›¾ä¹¦é¦†åŒ—é—¨', result: 'æˆåŠŸ', time: '2026-05-09 09:02', riskLevel: 'low' },
