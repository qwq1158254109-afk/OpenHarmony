//# sourceMappingURL=AttendanceStatsPage.js.mapÂ”ÙYE:\project\My_project\OpenHarmony\frontend\entry\src\main\ets\components\PageTitleBar.etsÙWE:\project\My_project\OpenHarmony\frontend\entry\src\main\ets\components\StatePanel.etsÙ\E:\project\My_project\OpenHarmony\frontend\entry\src\main\ets\services\PortalMockService.etsÙQE:\project\My_project\OpenHarmony\frontend\entry\src\main\ets\utils\Constants.etsÙ[E:\project\My_project\OpenHarmony\frontend\entry\src\main\ets\pages\AttendanceStatsPage.etsÔrBšªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ0E:\project\My_project\OpenHarmony\frontend\entryÙ*E:\project\My_project\OpenHarmony\frontend¥entry¥1.0.0Ô␀␀Ù0E:\project\My_project\OpenHarmony\frontend\entryÃÃÚ	üimport { PageTitleBar } from '../components/PageTitleBar';
import { StatePanel } from '../components/StatePanel';
import { AttendanceMetric, PageLoadState } from '../models/CampusPortal';
import { PortalMockService } from '../services/PortalMockService';
import { AppColors, AppLayout } from '../utils/Constants';

@Entry
@Component
struct AttendanceStatsPage {
  @State state: PageLoadState = 'loading';
  @State metrics: AttendanceMetric[] = [];

  aboutToAppear(): void {
    this.metrics = PortalMockService.attendanceMetrics();
    this.state = this.metrics.length === 0 ? 'empty' : 'ready';
  }

  private rate(item: AttendanceMetric): number {
    if (item.total === 0) {
      return 0;
    }
    return Math.round(item.attended * 100 / item.total);
  }

  build() {
    Scroll() {
      Column({ space: 16 }) {
        PageTitleBar({ title: 'è€ƒå‹¤ç»Ÿè®¡', subtitle: 'æŒ‰è¯¾ç¨‹å±•ç¤ºå­¦ç”Ÿåˆ°è¯¾ç‡å’Œæœ€è¿‘ç­¾åˆ°æ—¶é—´' })
        if (this.state !== 'ready') {
          StatePanel({ state: this.state, emptyText: 'æš‚æ— è€ƒå‹¤æ•°æ®', errorText: 'è€ƒå‹¤æ•°æ®åŠ è½½å¤±è´¥' })
        } else {
          ForEach(this.metrics, (item: AttendanceMetric) => {
            Column({ space: 10 }) {
              Row() {
                Text(item.course)
                  .fontSize(17)
                  .fontWeight(FontWeight.Bold)
                  .fontColor(AppColors.text)
                  .layoutWeight(1)
                Text(`${this.rate(item)}%`)
                  .fontSize(22)
                  .fontWeight(FontWeight.Bold)
                  .fontColor(this.rate(item) >= 90 ? AppColors.success : AppColors.warning)
              }
              Progress({ value: this.rate(item), total: 100, type: ProgressType.Linear })
                .color(this.rate(item) >= 90 ? AppColors.success : AppColors.warning)
                .height(8)
              Text(`å·²ç­¾åˆ° ${item.attended}/${item.total} Â· æœ€è¿‘ ${item.latestTime}`)
                .fontSize(12)
                .fontColor(AppColors.muted)
            }
            .width('100%')
            .padding(14)
            .backgroundColor(AppColors.surface)
            .borderRadius(8)
            .border({ width: 1, color: AppColors.border })
          }, (item: AttendanceMetric): string => item.id)
        }
      }
      .width('100%')
      .constraintSize({ maxWidth: AppLayout.pageMaxWidth })
      .alignSelf(ItemAlign.Center)
      .padding({ left: AppLayout.pagePadding, right: AppLayout.pagePadding, bottom: 30 })
    }
    .backgroundColor(AppColors.background)
  }
}
