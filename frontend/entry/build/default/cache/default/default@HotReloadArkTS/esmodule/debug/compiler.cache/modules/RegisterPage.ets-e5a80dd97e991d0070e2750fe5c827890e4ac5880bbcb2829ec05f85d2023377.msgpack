      return 'è¯·è¾“å…¥å§“å';
    }
    if (userCode.length === 0) {
      return 'è¯·è¾“å…¥å­¦å·/å·¥å·';
    }
    if (this.role !== 'student' && this.role !== 'teacher') {
      return 'è¯·é€‰æ‹©ç”¨æˆ·è§’è‰²';
    }
    if (phone.length > 0 && !/^1[3-9]\d{9}$/.test(phone)) {
      return 'è¯·è¾“å…¥æ­£ç¡®çš„æ‰‹æœºå·';
    }
    if (email.length > 0 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      return 'è¯·è¾“å…¥æ­£ç¡®çš„é‚®ç®±';
    }
    return '';
  }

  private submit(): void {
    if (this.submitting) {
      return;
    }
    const errorMessage = this.validate();
    if (errorMessage.length > 0) {
      promptAction.showToast({ message: errorMessage });
      this.tipMessage = errorMessage;
      return;
    }

    this.submitting = true;
    this.tipMessage = 'æ­£åœ¨æäº¤æ³¨å†Œä¿¡æ¯...';
    const request: RegisterRequest = {
      username: this.username.trim(),
      password: this.password.trim(),
      realName: this.realName.trim(),
      userCode: this.userCode.trim(),
      role: this.role,
      phone: this.phone.trim(),
      email: this.email.trim()
    };

    AuthService.register(request)
      .then((result: RegisterResponse) => {
        this.submitting = false;
        if (!result.success) {
          this.tipMessage = result.message;
          promptAction.showToast({ message: result.message });
          return;
        }
        promptAction.showToast({ message: 'æ³¨å†ŒæˆåŠŸï¼Œè¯·ç™»å½•' });
        router.replaceUrl({ url: AppRoutes.login });
      })
      .catch((error: Error) => {
        this.submitting = false;
        this.tipMessage = `æ³¨å†Œå¤±è´¥ï¼š${error.message}`;
        promptAction.showToast({ message: this.tipMessage });
      });
  }

  build() {
    Scroll() {
      Column({ space: 18 }) {
        PageTitleBar({ title: 'ç”¨æˆ·æ³¨å†Œ', subtitle: 'åˆ›å»ºæ ¡å›­è®¤è¯è´¦å·' })

        Column({ space: 12 }) {
          Text('åˆ›å»ºæ ¡å›­è®¤è¯è´¦å·')
            .fontSize(24)
            .fontWeight(FontWeight.Bold)
            .fontColor('#FFFFFF')
          Text('æ³¨å†ŒæˆåŠŸåå¯ä½¿ç”¨ç”¨æˆ·åå’Œå¯†ç ç™»å½•ï¼Œè§’è‰²æƒé™å°†è‡ªåŠ¨è¿›å…¥å¯¹åº”å­¦ç”Ÿç«¯æˆ–æ•™å¸ˆç«¯ã€‚')
            .fontSize(13)
            .fontColor('#D7EEF7')
            .lineHeight(20)
        }
        .width('100%')
        .alignItems(HorizontalAlign.Start)
        .padding(18)
        .backgroundColor(AppColors.hero)
        .borderRadius(8)

        Column({ space: 14 }) {
          this.FormInput('ç”¨æˆ·å', 'è¯·è¾“å…¥ 4 åˆ° 20 ä½ç”¨æˆ·å', this.username, false)
          this.FormInput('å¯†ç ', 'è¯·è¾“å…¥ä¸å°‘äº 6 ä½å¯†ç ', this.password, true)
          this.FormInput('ç¡®è®¤å¯†ç ', 'è¯·å†æ¬¡è¾“å…¥å¯†ç ', this.confirmPassword, true)
          this.FormInput('å§“å', 'è¯·è¾“å…¥çœŸå®å§“å', this.realName, false)
          this.FormInput('å­¦å·/å·¥å·', 'è¯·è¾“å…¥å­¦å·æˆ–å·¥å·', this.userCode, false)

          Column() {
            Text('é€‰æ‹©è§’è‰²')
              .fontSize(13)
              .fontColor(AppColors.muted)
              .width('100%')
              .margin({ bottom: 8 })
            Row({ space: 10 }) {
              ForEach(this.roles, (item: RegisterRole) => {
                Button(FormatUtil.roleLabel(item))
                  .layoutWeight(1)
                  .height(42)
                  .fontSize(14)
                  .fontColor((this.role === item || this.roleButtonHover === item) ? '#FFFFFF' : AppColors.primary)
                  .backgroundColor((this.role === item || this.roleButtonHover === item) ? AppColors.accent : AppColors.cyanSoft)
                  .borderRadius(8)
                  .shadow({
                    radius: this.roleButtonHover === item ? 10 : 2,
                    color: this.roleButtonHover === item ? '#22000000' : '#08000000',
                    offsetX: 0,
                    offsetY: this.roleButtonHover === item ? 4 : 1
                  })
                  .scale({ x: this.roleButtonHover === item ? 1.03 : 1, y: this.roleButtonHover === item ? 1.03 : 1 })
                  .animation({ duration: 150, curve: Curve.EaseOut })
                  .hoverEffect(HoverEffect.Highlight)
                  .onHover((isHover: boolean) => {
                    this.roleButtonHover = isHover ? item : '';
                  })
                  .onClick(() => {
                    this.role = item;
                  })
              }, (item: RegisterRole): string => item)
            }
            .width('100%')
          }

          this.FormInput('æ‰‹æœºå·', 'é€‰å¡«ï¼Œä¾‹å¦‚ 13800138000', this.phone, false)
          this.FormInput('é‚®ç®±', 'é€‰å¡«ï¼Œä¾‹å¦‚ user@example.com', this.email, false)

          Text(this.tipMessage)
            .fontSize(12)
            .fontColor(this.tipMessage.includes('å¤±è´¥') || this.tipMessage.includes('ä¸') || this.tipMessage.includes('è¯·è¾“å…¥') ? AppColors.danger : AppColors.primary)
            .lineHeight(18)
            .width('100%')

          Button(this.submitting ? 'æ­£åœ¨æ³¨å†Œ...' : 'æ³¨å†Œ')
            .width('100%')
            .height(50)
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor('#FFFFFF')
            .backgroundColor(this.submitting ? AppColors.borderStrong : (this.submitButtonHover ? AppColors.accent : AppColors.primary))
            .borderRadius(8)
            .shadow({
              radius: this.submitButtonHover ? 14 : 4,
              color: this.submitButtonHover ? '#26000000' : '#10000000',
              offsetX: 0,
              offsetY: this.submitButtonHover ? 5 : 2
            })
            .scale({ x: this.submitButtonHover ? 1.02 : 1, y: this.submitButtonHover ? 1.02 : 1 })
            .animation({ duration: 150, curve: Curve.EaseOut })
            .hoverEffect(HoverEffect.Highlight)
            .onHover((isHover: boolean) => {
              this.submitButtonHover = isHover && !this.submitting;
            })
            .onClick(() => {
              this.submit();
            })

          Button('å·²æœ‰è´¦å·ï¼Ÿå»ç™»å½•')
            .width('100%')
            .height(44)
            .fontSize(14)
            .fontColor(this.loginButtonHover ? '#FFFFFF' : AppColors.primary)
            .backgroundColor(this.loginButtonHover ? AppColors.accent : AppColors.cyanSoft)
            .borderRadius(8)
            .shadow({
              radius: this.loginButtonHover ? 12 : 3,
              color: this.loginButtonHover ? '#22000000' : '#0A000000',
              offsetX: 0,
              offsetY: this.loginButtonHover ? 4 : 1
            })
            .scale({ x: this.loginButtonHover ? 1.02 : 1, y: this.loginButtonHover ? 1.02 : 1 })
            .animation({ duration: 150, curve: Curve.EaseOut })
            .hoverEffect(HoverEffect.Highlight)
            .onHover((isHover: boolean) => {
              this.loginButtonHover = isHover;
            })
            .onClick(() => {
              this.goLogin();
            })
        }
        .width('100%')
        .padding(18)
        .backgroundColor(AppColors.surface)
        .borderRadius(8)
        .border({ width: 1, color: AppColors.border })
      }
      .width('100%')
      .constraintSize({ maxWidth: AppLayout.pageMaxWidth })
      .alignSelf(ItemAlign.Center)
      .padding({ left: AppLayout.pagePadding, right: AppLayout.pagePadding, bottom: 32 })
    }
    .backgroundColor(AppColors.background)
  }

  @Builder
  FormInput(label: string, placeholder: string, value: string, passwordMode: boolean) {
    Column() {
      Text(label)
        .fontSize(13)
        .fontColor(AppColors.muted)
        .width('100%')
        .margin({ bottom: 8 })
      TextInput({ placeholder: placeholder, text: value })
        .height(48)
        .fontSize(15)
        .type(passwordMode ? InputType.Password : InputType.Normal)
        .backgroundColor(AppColors.surfaceSoft)
        .borderRadius(8)
        .border({ width: 1, color: AppColors.border })
        .padding({ left: 12, right: 12 })
        .onChange((text: string) => {
          if (label === 'ç”¨æˆ·å') {
            this.username = text;
          } else if (label === 'å¯†ç ') {
            this.password = text;
          } else if (label === 'ç¡®è®¤å¯†ç ') {
            this.confirmPassword = text;
          } else if (label === 'å§“å') {
            this.realName = text;
          } else if (label === 'å­¦å·/å·¥å·') {
            this.userCode = text;
          } else if (label === 'æ‰‹æœºå·') {
            this.phone = text;
          } else {
            this.email = text;
          }
        })
    }
    .width('100%')
  }
}
