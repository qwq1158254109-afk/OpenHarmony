            .width(96)
            Column() {
              Text(`${this.latestRiskRecord().userName} Â· ${FormatUtil.sceneLabel(this.latestRiskRecord().scene)}`)
                .fontSize(16)
                .fontWeight(FontWeight.Bold)
                .fontColor(AppColors.text)
              Text(this.latestRiskRecord().risk.riskReason)
                .fontSize(13)
                .fontColor(AppColors.muted)
                .lineHeight(19)
                .margin({ top: 6 })
              Text(this.latestRiskRecord().risk.suggestion)
                .fontSize(12)
                .fontColor(this.riskColor(this.latestRiskRecord()))
                .lineHeight(18)
                .margin({ top: 6 })
            }
            .alignItems(HorizontalAlign.Start)
            .layoutWeight(1)
          }
          .width('100%')
          .padding(16)
          .backgroundColor(AppColors.surface)
          .borderRadius(8)
          .border({ width: 1, color: this.riskColor(this.latestRiskRecord()) })
        }

        Column({ space: 12 }) {
          SectionHeader({ title: 'é£é™©æ—¥å¿—', subtitle: 'ç”¨äºç­”è¾©å±•ç¤ºç®¡ç†å‘˜å®¡è®¡èƒ½åŠ›' })
          ForEach(this.abnormalRecords().slice(0, 5), (item: AuthRecord) => {
            Column({ space: 8 }) {
              Row() {
                Text('!')
                  .fontSize(18)
                  .fontWeight(FontWeight.Bold)
                  .fontColor('#FFFFFF')
                  .textAlign(TextAlign.Center)
                  .width(40)
                  .height(40)
                  .backgroundColor(item.risk.riskLevel === 'high' ? AppColors.danger : AppColors.warning)
                  .borderRadius(8)
                Column() {
                  Text(`${item.userName} Â· ${FormatUtil.sceneLabel(item.scene)}`)
                    .fontSize(16)
                    .fontWeight(FontWeight.Bold)
                    .fontColor(AppColors.text)
                  Text(`${item.time} Â· ${item.location}`)
                    .fontSize(12)
                    .fontColor(AppColors.muted)
                    .margin({ top: 4 })
                }
                .alignItems(HorizontalAlign.Start)
                .layoutWeight(1)
                .margin({ left: 12 })
                StatusBadge({ text: FormatUtil.riskLabel(item.risk.riskLevel), status: item.risk.riskLevel })
              }
              Text(item.risk.riskReason)
                .fontSize(13)
                .fontColor(AppColors.muted)
                .lineHeight(19)
              Text(item.risk.suggestion)
                .fontSize(12)
                .fontColor(AppColors.danger)
                .lineHeight(18)
            }
            .width('100%')
            .padding(14)
            .backgroundColor(AppColors.surface)
            .borderRadius(8)
            .border({ width: 1, color: AppColors.border })
          }, (item: AuthRecord) => item.id)
        }
      }
      .width('100%')
      .constraintSize({ maxWidth: AppLayout.pageMaxWidth })
      .alignSelf(ItemAlign.Center)
      .padding({ left: AppLayout.pagePadding, right: AppLayout.pagePadding, bottom: 30 })
    }
    .backgroundColor(AppColors.background)
  }
}
